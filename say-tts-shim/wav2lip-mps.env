# Wav2Lip runtime knobs. These MUST be real environment variables: the runtime
# reads them with os.environ.get(), and OpenTalking's .env is loaded by
# pydantic-settings, which does not populate os.environ. Putting them only in
# .env silently leaves the runtime on its defaults (device=cpu, jpeg 85).
# Pass this file with: scripts/start_unified.sh --env <this file>

export OPENTALKING_WAV2LIP_MODEL_ROOT=/Users/kjs0703/playground/opentalk/models/wav2lip

# 384px. The 96px variant pasted a 96x96 patch into a 222x304 face box on
# office-woman -- a 2.31x upscale, which is where the mouth blur came from.
# At 384 that is a 0.58x downscale instead. Variant is auto-detected from the
# state dict. wav2lip256 also clears the upscale (0.87x) at 50fps vs 17fps.
export OPENTALKING_WAV2LIP_CHECKPOINT=/Users/kjs0703/playground/opentalk/models/wav2lip/wav2lip384.pth

export OPENTALKING_WAV2LIP_DEVICE=mps
export OPENTALKING_WAV2LIP_FACE_DET_DEVICE=mps
export OPENTALKING_WAV2LIP_BATCH_SIZE=8

# Every generated frame is JPEG-encoded on the way to the video writer; 85 is a
# second quality loss stacked on top of the patch upscale.
export OPENTALKING_WAV2LIP_JPEG_QUALITY=97

# Only affects the realtime runtime; video creation ignores it for wav2lip.
export OPENTALKING_WAV2LIP_MAX_LONG_EDGE=1280
