# Both local talking-head models on Apple Silicon MPS.
# These MUST be real environment variables: the runtimes read them with
# os.environ.get(), and OpenTalking's .env is loaded by pydantic-settings,
# which does not populate os.environ.
#   bash scripts/start_unified.sh --backend local --model quicktalk \
#     --api-port 8210 --web-port 5280 --env ../say-tts-shim/local-mps.env

# ---- Wav2Lip ------------------------------------------------------------
export OPENTALKING_WAV2LIP_MODEL_ROOT=/Users/kjs0703/playground/opentalk/models/wav2lip
export OPENTALKING_WAV2LIP_CHECKPOINT=/Users/kjs0703/playground/opentalk/models/wav2lip/wav2lip384.pth
export OPENTALKING_WAV2LIP_DEVICE=mps
export OPENTALKING_WAV2LIP_FACE_DET_DEVICE=mps
export OPENTALKING_WAV2LIP_BATCH_SIZE=8
export OPENTALKING_WAV2LIP_JPEG_QUALITY=97
export OPENTALKING_WAV2LIP_MAX_LONG_EDGE=1280

# ---- QuickTalk ----------------------------------------------------------
# The only model in the repo with explicit MPS handling: adapter.py auto-detects
# mps, and runtime_v2 routes ONNX to CoreMLExecutionProvider when it is there.
export OPENTALKING_QUICKTALK_ASSET_ROOT=/Users/kjs0703/playground/opentalk/models/quicktalk
export OPENTALKING_QUICKTALK_DEVICE=mps
# `auto` picks pth over onnx when checkpoints/quicktalk.pth exists, which keeps
# the generator in pure PyTorch on MPS. Force it so the choice is explicit.
export OPENTALKING_QUICKTALK_MODEL_BACKEND=pth
# HuBERT-large is the audio encoder (vs Wav2Lip's raw mel). Start it on mps and
# fall back to cpu if an operator is missing.
export OPENTALKING_QUICKTALK_HUBERT_DEVICE=mps
# The Apple Silicon notes disable the worker cache; it trades startup time for
# memory and has not been validated here.
export OPENTALKING_QUICKTALK_WORKER_CACHE=0

# easy_improved (the default) leaves a visible rectangular paste-back seam on
# the newscaster avatar -- a dark patch beside the face in the hair, present in
# every frame. opentalking_improved blends it away. Per-avatar manifests can
# still override this: office-woman and laozi already ask for it.
export OPENTALKING_WAV2LIP_POSTPROCESS_MODE=opentalking_improved
